# 股票分析系统安全配置示例
# Stock Analysis System Security Configuration Example
#
# 重要提醒:
# 1. 复制此文件为 .env 并填入真实值
# 2. 生产环境必须使用强密码和随机密钥
# 3. 不要将真实密码提交到版本控制
#
# IMPORTANT REMINDERS:
# 1. Copy this file to .env and fill in real values
# 2. Production environment must use strong passwords and random keys
# 3. Never commit real passwords to version control

# =================================
# 数据库配置 (Database Configuration)
# =================================
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
# 请设置强密码，至少8位，包含大小写字母、数字和特殊字符
DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DATABASE_NAME=stock_analysis_dev

# MySQL完整连接URL（可选，优先级高于单独配置）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/stock_analysis_dev

# =================================
# JWT 安全配置 (JWT Security Configuration)
# =================================
# 主要JWT密钥，必须至少32个字符，生产环境请使用随机生成的密钥
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YOUR_32_CHARACTER_RANDOM_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员JWT配置
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=YOUR_32_CHARACTER_ADMIN_SECRET_KEY_HERE
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT算法 (不建议修改)
ALGORITHM=HS256

# =================================
# 应用配置 (Application Configuration)
# =================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# 服务器配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8006
CLIENT_PORT=8005

# API配置
API_V1_STR=/api/v1
PROJECT_NAME=Stock Analysis System - Development

# =================================
# 前端配置 (Frontend Configuration)
# =================================
VITE_API_URL=http://localhost:8000
VITE_CLIENT_API_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_ENVIRONMENT=development

# =================================
# 支付配置 (Payment Configuration)
# =================================
# 微信支付配置 (必需配置)
WECHAT_APPID=wx1234567890abcdef  # 微信公众号/小程序 AppID，请替换为真实值
WECHAT_MCH_ID=1725935616  # 商户号
WECHAT_API_KEY=ChenZhenyuqianqian18861888886137  # 32位密钥
WECHAT_CERT_SERIAL=2CFBD918985AEEE2EF5093BFD556D1B14B080963  # API证书序列号
WECHAT_CERT_PATH=certs/apiclient_cert.pem  # 商户证书路径
WECHAT_KEY_PATH=certs/apiclient_key.pem   # 商户私钥路径
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payment/notify  # 支付回调地址（必须HTTPS）

# 支付功能开关
PAYMENT_ENABLED=true
PAYMENT_MOCK_MODE=true
PAYMENT_ORDER_TIMEOUT_HOURS=2

# =================================
# 缓存配置 (Cache Configuration)
# =================================
# Redis配置 (可选)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_DB=0

# =================================
# 邮件配置 (Email Configuration)
# =================================
# SMTP邮件配置 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=your_email@example.com

# =================================
# 安全配置 (Security Configuration)
# =================================
# 基础URL (用于回调)
BASE_URL=http://localhost:8000

# 允许的源站 (CORS)
ALLOWED_ORIGINS=http://localhost:8005,http://localhost:8006

# SSL配置 (生产环境)
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# 数据库连接池配置
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =================================
# 文件配置 (File Configuration)
# =================================
# 文件上传配置
MAX_FILE_SIZE=104857600
UPLOAD_DIR=uploads

# 日志配置
LOG_FILE=logs/app.log

# =================================
# 安全提示 (Security Tips)
# =================================
# 1. 密码要求:
#    - 至少8个字符
#    - 包含大写字母、小写字母、数字和特殊字符
#    - 不使用常见密码（如password123、admin123等）
#
# 2. 密钥生成:
#    - 使用随机生成的密钥，不要使用可预测的字符串
#    - Python生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
#    - 或使用在线工具: https://www.uuidgenerator.net/
#
# 3. 环境隔离:
#    - 开发、测试、生产环境使用不同的密钥和密码
#    - 定期更换密钥和密码
#
# 4. 访问控制:
#    - 限制数据库访问IP
#    - 使用防火墙保护服务器
#    - 定期检查访问日志